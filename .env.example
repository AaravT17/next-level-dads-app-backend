ENV=development
FRONTEND_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://...?pgbouncer=true
REDIS_URL=redis://localhost:6379
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Optional. How many of our own proxies sit in front of the app, counted from
# the right of X-Forwarded-For; anything further left was written by the caller
# and is not trusted for rate limiting. Defaults to 1 in production, 0 otherwise.
TRUSTED_PROXY_HOPS=0
# Optional. A single-value client-IP header set by the edge, preferred over
# X-Forwarded-For because a client cannot append to it.
# TRUSTED_CLIENT_IP_HEADER=True-Client-IP
